# Copy to .env and fill in real values. Injected at runtime via `env_file` — never baked into the image.

# Redis (BullMQ). In docker-compose these are overridden to the `redis` service.
REDIS_HOST=localhost
REDIS_PORT=6379

# Supabase (service key — server-side only, keep secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# JWKS endpoint used to verify user JWTs on /api/v1/comms routes.
# Optional: falls back to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Present in config; not currently read by the backend source.
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Stripe (platform account secret key)
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the Connect webhook endpoint ("Listen to events on Connected accounts").
# In dev, use the whsec printed by: stripe listen --forward-connect-to localhost:5000/api/v1/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Fallback platform fee per payment, in whole MXN pesos. Only used when the
# tenant's plan is unknown — normally the fee comes from PLAN_FEE_MXN
# (billing.controller.ts): arranque $10, basico $8, esencial $5, pro $2.
PLATFORM_FEE_MXN=10

# --- SaaS subscription (platform account, NOT Connect) ---
# Plain recurring monthly Prices created in the Stripe Dashboard — one flat
# amount per plan, quantity always 1. House limits are a HARD CAP enforced in
# fraccio-web (createHouseFn), so there is no overage and no tiered pricing.
# Suggested: Basico $490, Esencial $990, Pro $1890 MXN.
STRIPE_PRICE_BASICO=price_...
STRIPE_PRICE_ESENCIAL=price_...
STRIPE_PRICE_PRO=price_...
# Signing secret of the ACCOUNT webhook endpoint (events on your own account).
# In dev: stripe listen --forward-to localhost:5000/api/v1/webhooks/stripe/billing
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
# Web app base URL for Stripe redirect (checkout success/cancel, onboarding return)
WEB_BASE_URL=http://localhost:3000

# Mailgun (US region API). MAILGUN_FROM e.g. "Fraccio <no-reply@mg.example.com>"
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM="Fraccio <no-reply@mg.example.com>"
